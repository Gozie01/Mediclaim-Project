# ── PureChain deployment keys ─────────────────────────────────────────────────
# Admin / deployer account
PRIVATE_KEY=0x...your_deployer_private_key

# Oracle node 1, 2, 3 keys (used in oracle/node1.js, node2.js, node3.js)
PRIVATE_KEY2=0x...oracle_node_1_private_key
PRIVATE_KEY3=0x...oracle_node_2_private_key
PRIVATE_KEY4=0x...oracle_node_3_private_key

# ML fraud oracle key
PRIVATE_KEY_ML=0x...ml_oracle_private_key

# Hospital and patient demo accounts
PRIVATE_KEY_HOSPITAL=0x...hospital_private_key
PRIVATE_KEY_PATIENT=0x...patient_private_key
PRIVATE_KEY_INSURER=0x...insurer_private_key

# ── Pinata IPFS ────────────────────────────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# ── Contract addresses (filled after deploy.js) ────────────────────────────────
ZK_VERIFIER_ADDRESS=
PATIENT_PROFILE_ADDRESS=
INSURANCE_POLICY_ADDRESS=
MULTI_ORACLE_ADDRESS=
MEDI_CLAIM_ADDRESS=

# ── Optional: CoinMarketCap for USD gas estimates ─────────────────────────────
COINMARKETCAP_API_KEY=
