pragma solidity ^0.8.20;

// ─────────────────────────────────────────────────────────────────────────────
// ZKConsentVerifier — Gap 3 (Privacy: ZK-proof consent verification)
//
// Phase 1: zkEnforced = false  → proof is bypassed (allows full system to run)
// Phase 3: circom consent_proof.circom is compiled, snarkjs generates the real
//          Groth16 verifier, this contract is replaced and zkEnforced = true.
//
// The circuit proves:
//   "I know a secret (patientSecret) such that
//    hash(patientAddress, patientSecret) == publicCommitment"
// — verifying patient identity without revealing any PHI on-chain.
// ─────────────────────────────────────────────────────────────────────────────

interface IZKConsentVerifier {
    function verifyProof(
        uint256[2] calldata _pA,
        uint256[2][2] calldata _pB,
        uint256[2] calldata _pC,
        uint256[1] calldata _pubSignals
    ) external view returns (bool);
}

contract ZKConsentVerifier is IZKConsentVerifier {

    address public admin;
    bool public zkEnforced;

    // Groth16 verification key fields (populated in Phase 3 by snarkjs export)
    // Left as zero for Phase 1 placeholder deployment
    uint256[2] public vkAlpha1;
    uint256[2][2] public vkBeta2;
    uint256[2] public vkGamma2_0;
    uint256[2] public vkGamma2_1;
    uint256[2] public vkDelta2_0;
    uint256[2] public vkDelta2_1;
    uint256[][] public vkIc;

    event ZKEnforcementEnabled(uint256 timestamp);
    event VerificationKeyUpdated(uint256 timestamp);

    modifier onlyAdmin() {
        require(msg.sender == admin, "ZKVerifier: not admin");
        _;
    }

    constructor() {
        admin = msg.sender;
        zkEnforced = false;
    }

    // ── Phase 3: called after snarkjs generates the verification key ──────────
    function setVerificationKey(
        uint256[2] calldata _alpha1,
        uint256[2][2] calldata _beta2,
        uint256[2] calldata _gamma2_0,
        uint256[2] calldata _gamma2_1,
        uint256[2] calldata _delta2_0,
        uint256[2] calldata _delta2_1,
        uint256[][] calldata _ic
    ) external onlyAdmin {
        vkAlpha1 = _alpha1;
        vkBeta2 = _beta2;
        vkGamma2_0 = _gamma2_0;
        vkGamma2_1 = _gamma2_1;
        vkDelta2_0 = _delta2_0;
        vkDelta2_1 = _delta2_1;
        vkIc = _ic;
        emit VerificationKeyUpdated(block.timestamp);
    }

    // ── Toggle ZK enforcement on after Phase 3 keys are set ──────────────────
    function enableZKEnforcement() external onlyAdmin {
        require(vkIc.length > 0, "ZKVerifier: verification key not set");
        zkEnforced = true;
        emit ZKEnforcementEnabled(block.timestamp);
    }

    // ── Main verification entry point ─────────────────────────────────────────
    function verifyProof(
        uint256[2] calldata _pA,
        uint256[2][2] calldata _pB,
        uint256[2] calldata _pC,
        uint256[1] calldata _pubSignals
    ) external view override returns (bool) {
        if (!zkEnforced) {
            // Phase 1: bypass — all consent grants are allowed
            return true;
        }
        // Phase 3: real Groth16 verification via pairing check
        return _groth16Verify(_pA, _pB, _pC, _pubSignals);
    }

    // ── Internal Groth16 stub (replaced by snarkjs output in Phase 3) ─────────
    function _groth16Verify(
        uint256[2] calldata,
        uint256[2][2] calldata,
        uint256[2] calldata,
        uint256[1] calldata
    ) internal pure returns (bool) {
        // Replaced in Phase 3 with actual elliptic curve pairing checks
        // generated by: snarkjs zkey export solidityverifier consent_proof_final.zkey verifier.sol
        return true;
    }
}
